generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now()) @map("created_at")

  documents     Document[]
  conversations Conversation[]

  @@map("users")
}

model Document {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  filePath     String?   @map("file_path")
  content      String?
  status       String    @default("pending")
  title        String?
  documentType String?   @map("document_type")
  createdAt    DateTime  @default(now()) @map("created_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis              Analysis?
  conversationDocuments ConversationDocument[]

  @@map("documents")
}

model Analysis {
  id         Int      @id @default(autoincrement())
  documentId Int      @unique @map("document_id")
  summary    String
  riskLevel  String   @map("risk_level")
  riskScore  Int?      @map("risk_score")
  clauses    String[]  @default([])
  riskItems  Json      @default("[]") @map("risk_items")
  createdAt  DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("analyses")
}

model Conversation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String?
  language  String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  documents ConversationDocument[]

  @@map("conversations")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  role           String
  content        String
  kind           String   @default("text")
  clarifyOptions Json?    @map("clarify_options")
  citations      Json?
  audioUrl       String?  @map("audio_url")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ConversationDocument {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  documentId     Int      @map("document_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([conversationId, documentId])
  @@map("conversation_documents")
}

model LegalKnowledgeChunk {
  id          Int       @id @default(autoincrement())
  sourceUrl   String    @map("source_url")
  sourceTitle String    @map("source_title")
  act         String?
  section     String?
  content     String
  embedding   Unsupported("vector(1536)")
  publishedAt DateTime? @map("published_at")
  crawledAt   DateTime  @default(now()) @map("crawled_at")
  contentHash String    @unique @map("content_hash")

  @@map("legal_knowledge_chunks")
}
